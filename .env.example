# Copy this to company-os/.env, in the SAME folder as docker-compose.yml.
# No working passwords or secrets are shipped. Do not commit .env to Git.
# Minimum 12 characters; use a unique randomly generated password.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# At least 32 RANDOM characters; recommended: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# 32 RANDOM bytes as 64 hex characters; keep the same key to decrypt existing HR documents.
# python -c "import secrets; print(secrets.token_hex(32))"
HR_ENCRYPTION_KEY=
