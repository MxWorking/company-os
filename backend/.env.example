# For manual uvicorn development ONLY. With Docker Compose use .env at repository root.
# Development only. Never use demo mode for production organizations.
APP_ENV=development
DEMO_MODE=false
DATABASE_URL=sqlite:///./company_os.db
# Configure secrets before enabling production:
SESSION_SECRET=replace-with-random-64-character-secret
ADMIN_USERNAME=company-owner
ADMIN_PASSWORD=
# Optional (recommended for Vercel): sync the ONE existing company-os owner
# username/password when the backend starts; never creates a second admin.
ADMIN_ENV_SYNC=false
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Required for encrypted national ID, phone and document upload; generate 32 random bytes as hex
# python -c "import secrets; print(secrets.token_hex(32))"
HR_ENCRYPTION_KEY=
# Optional public contact display only; tickets stay local in this release
DEVELOPER_SUPPORT_EMAIL=
INTERNAL_SUPPORT_CONTACT=

# APP_ENV=test and DEMO_MODE=true is isolated for pytest; NEVER enable it on a running server.
