# For manual uvicorn development ONLY. With Docker Compose use .env at repository root.
# Development only. Never use demo mode for production organizations.
APP_ENV=development
DEMO_MODE=false
DATABASE_URL=sqlite:///./company_os.db
# Set only the admin credentials here. The app automatically manages its internal cryptographic root.
ADMIN_USERNAME=company-owner
ADMIN_PASSWORD=
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional public contact display only; tickets stay local in this release
DEVELOPER_SUPPORT_EMAIL=
INTERNAL_SUPPORT_CONTACT=

# APP_ENV=test and DEMO_MODE=true is isolated for pytest; NEVER enable it on a running server.
